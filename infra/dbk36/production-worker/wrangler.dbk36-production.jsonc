{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dbk36-whatsapp-production",
  "main": "./dbk36-prod-worker.mjs",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "vars": {
    "DBK36_PRODUCTION_WORKER": "YES",
    "DBK36_STAGING_WORKER": "NO",
    "DBK36_PRODUCTION_BACKEND_ORIGIN": "https://www.decorbykasiwa.co.ke",
    "DBK36_PRODUCTION_META_ENABLED": "NO",
    "DBK36_PRODUCTION_YCLOUD_ENABLED": "NO",
    "DBK36_YCLOUD_PUBLIC_BOT": "NO",
    "DBK36_YCLOUD_SENDER_NUMBER": "+254117553747",
    "DBK36_YCLOUD_EXPECTED_WABA_ID": "1659955715520682",
    "DBK36_YCLOUD_META_PHONE_NUMBER_ID": "1485264144663755",
    "DBK36_YCLOUD_TEST_NUMBERS": "",
    "DBK36_PRODUCTION_MPESA_CALLBACK_ENABLED": "NO",
    "DBK36_PRODUCTION_RECONCILE_ENABLED": "NO",
    "DBK36_PRODUCTION_MESSAGE_RECOVERY_ENABLED": "NO",
    "DBK36_PRODUCTION_CATALOGUE_REFRESH_ENABLED": "YES"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "*/30 * * * *"
    ]
  }
}
