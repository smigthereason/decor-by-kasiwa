NEXT_PUBLIC_SANITY_PROJECT_ID=g34n810u
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=

NEXT_PUBLIC_SITE_URL=https://decorbykasiwa.co.ke

SMTP_HOST=mail.decorbykasiwa.co.ke
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=info@decorbykasiwa.co.ke
SMTP_PASSWORD=

SMTP_FROM="Decor by Kasiwa <info@decorbykasiwa.co.ke>"
EMAIL_REPLY_TO=info@decorbykasiwa.co.ke
AUTH_EMAIL_FROM="Decor by Kasiwa <info@decorbykasiwa.co.ke>"
ORDER_EMAIL_FROM="Decor by Kasiwa <info@decorbykasiwa.co.ke>"



# E-commerce delivery zones/rates are managed in Admin → Settings and stored in Sanity.

# Direct Safaricom Daraja M-PESA for in-store POS.
# Paystack remains the online/e-commerce payment provider.
MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=7170781
# Optional: set this to the Till/receiver number if Safaricom's live app configuration gives a different PartyB.
# If blank, the integration uses MPESA_SHORTCODE.
MPESA_PARTY_B=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
MPESA_CALLBACK_URL=https://www.decorbykasiwa.co.ke/api/payments/mobile/callback

# Neon operational database (server-only). Never use NEXT_PUBLIC_* for secrets.
# Configure after applying DBK-45/47, deploying the code, and confirming Neon schema.
DATABASE_URL=
DBK_EXPENSE_BACKEND=sanity
DBK_EXPENSE_READ_NEON=0
DBK_STAFF_ACTIVITY_BACKEND=sanity
# DBK-47: read historical audit/session snapshots from DBK-46 Neon archive.
# Does not move new POS/stock/payment writes. Leave off until tested.
DBK_AUDIT_ARCHIVE_READ=0
